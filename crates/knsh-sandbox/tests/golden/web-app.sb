(version 1)
(deny default (with message "knsh:00000000000000000000000001:00000000000000000000000002:default"))
(allow file-read*)
(allow file-write* (subpath "/Users/u/src/app") (subpath "/private/var/folders/xy/T") (subpath "/Users/u/.claude"))
(allow file-write* (literal "/dev/null") (literal "/dev/zero") (literal "/dev/stdout") (literal "/dev/stderr") (regex #"^/dev/fd/[0-9]+$"))
(deny file-read* file-write* (subpath "/Users/u/.ssh") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fs.deny[0]"))
(deny file-read* file-write* (subpath "/Users/u/.aws") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fs.deny[1]"))
(deny file-read* file-write* (subpath "/Users/u/.gnupg") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fs.deny[2]"))
(deny file-read* file-write* (subpath "/Users/u/Library/Keychains") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fs.deny[3]"))
(deny file-read* file-write* (subpath "/Users/u/Library/Mail") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fs.deny[4]"))
(deny file-read* file-write* (subpath "/Users/u/Library/Messages") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fs.deny[5]"))
(deny file-write* (regex #"/\.git$") (regex #"/\.git/(.+/)?hooks(/|$)") (regex #"/\.git/(.+/)?(config|config\.worktree|commondir)$") (regex #"/\.git/(.+/)?(modules|worktrees)(/[^/]+)?$") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fixed.git"))
(deny file-write* (literal "/Users/u/.zshenv") (literal "/Users/u/.zprofile") (literal "/Users/u/.zshrc") (literal "/Users/u/.zlogin") (literal "/Users/u/.zlogout") (literal "/Users/u/.bash_profile") (literal "/Users/u/.bash_login") (literal "/Users/u/.bashrc") (literal "/Users/u/.bash_logout") (literal "/Users/u/.profile") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fixed.shell-startup"))
(deny file-write* (subpath "/Users/u/Library/LaunchAgents") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fixed.launch-agents"))
(deny file-write* (subpath "/Users/u/.ssh") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fixed.ssh"))
(deny file-write* (literal "/") (literal "/Users") (literal "/Users/u") (literal "/Users/u/.config") (literal "/Users/u/Library") (literal "/Users/u/Library/Application Support") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fixed.ancestors"))
(deny file-read* file-write* (subpath "/Users/u/Library/Application Support/knsh") (subpath "/Users/u/.config/knsh") (with message "knsh:00000000000000000000000001:00000000000000000000000002:fixed.engine"))

# Build output of the workspace only: an unanchored `target/` also hid vendored sources such as
# vendor/cc-1.11.2/src/target/, which broke the offline fuzz build in CI.
/target/
# Fuzzing output (KNSH-005): build products, crash artefacts and coverage. Saved crashes
# worth keeping are copied into fuzz/regressions/ by hand.
/fuzz/target/
fuzz/artifacts/
fuzz/coverage/
# Temporary home directories of engine-directory integration tests (KNSH-011), removed when the tests end.
crates/*/.knsh-test-home-*/
# Benchmark results (KNSH-024): written by scripts/startup-bench.sh, recorded in the specs by hand.
.build/

# User guide build (scripts/build-docs.sh).
.venv-docs/
site-docs/
